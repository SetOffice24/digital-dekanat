generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  TEACHER
}

enum Assessment {
  EXAM
  CREDIT
  GRADED_CREDIT
  COURSEWORK
}

enum LessonKind {
  LECTURE
  PRACTICE
  LAB
  EXAM
  CONSULTATION
}

enum LessonStatus {
  SCHEDULED
  MOVED
  CANCELLED
}

enum GradeKind {
  CURRENT
  MIDTERM
  FINAL
  RETAKE
}

enum ExamKind {
  EXAM
  CREDIT
  RETAKE
}

enum RequestStatus {
  NEW
  IN_REVIEW
  NEED_INFO
  READY
  DONE
  REJECTED
}

enum Audience {
  ALL
  FACULTY
  GROUP
}

enum NotificationKind {
  SCHEDULE_CHANGE
  REQUEST_STATUS
  ANNOUNCEMENT
  DEADLINE
  GRADE
  SYSTEM
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id            String         @id @default(cuid())
  login         String         @unique
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now())
  /// заблокирован деканатом: войти нельзя, сессии удалены
  blockedAt     DateTime?
  blockReason   String?
  /// выдан временный пароль — при входе обязательно задать свой
  mustChangePassword Boolean @default(false)
  lastLoginAt   DateTime?
  accountActions AccountEvent[] @relation("AccountActor")
  sessions      Session[]
  student       Student?
  staff         Staff?
  teacher       Teacher?
  notifications Notification[]
  events        RequestEvent[]
  pushSubs      PushSubscription[]
  uploads       Attachment[]
  conversations ConversationParticipant[]
  messages      Message[]
  conversationsStarted Conversation[] @relation("ConversationStarter")
}

/** Подписка устройства на push-уведомления (Web Push). Одно устройство/браузер — одна запись. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Faculty {
  id            String         @id @default(cuid())
  name          String
  shortName     String
  programs      Program[]
  students      Student[]
  staff         Staff[]
  announcements Announcement[]
  deadlines     Deadline[]
}

model Program {
  id        String    @id @default(cuid())
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  name      String
  code      String
  groups    Group[]
  students  Student[]
}

model Group {
  id            String         @id @default(cuid())
  programId     String
  program       Program        @relation(fields: [programId], references: [id])
  name          String         @unique
  course        Int
  students      Student[]
  lessons       Lesson[]
  exams         Exam[]
  announcements Announcement[]
  deadlines     Deadline[]
  materials     Material[]
  assignments   Assignment[]
}

model Student {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastName     String
  firstName    String
  middleName   String?
  facultyId    String
  faculty      Faculty            @relation(fields: [facultyId], references: [id])
  programId    String
  program      Program            @relation(fields: [programId], references: [id])
  course       Int
  groupId      String
  group        Group              @relation(fields: [groupId], references: [id])
  subgroup     Int
  recordBookNo String
  email        String?
  scholarship  Boolean            @default(false)
  enrollments  Enrollment[]
  requests     Request[]
  checkins     WellbeingCheckin[]
  aiChats      AiChat[]
  aiMessages   AiMessage[]
  attendance   Attendance[]
  submissions  Submission[]
  photos       StudentPhoto[]
  accountEvents AccountEvent[]
  /// код электронного студенческого билета (QR → публичная проверка «действующий студент»)
  idCode       String?            @unique
}

model Staff {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  position      String
  facultyId     String?
  faculty       Faculty?       @relation(fields: [facultyId], references: [id])
  announcements Announcement[]
  requests      Request[]
}

model Teacher {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName   String
  department  String
  lessons     Lesson[]
  materials   Material[]
  assignments Assignment[]
}

model Course {
  id          String       @id @default(cuid())
  name        String
  department  String
  assessment  Assessment
  lessons     Lesson[]
  enrollments Enrollment[]
  exams       Exam[]
  deadlines   Deadline[]
  materials   Material[]
  assignments Assignment[]
}

model Lesson {
  id            String       @id @default(cuid())
  groupId       String
  group         Group        @relation(fields: [groupId], references: [id])
  subgroup      Int?
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  teacherId     String
  teacher       Teacher      @relation(fields: [teacherId], references: [id])
  date          DateTime     @db.Date
  startTime     String
  endTime       String
  room          String
  building      String
  kind          LessonKind
  status        LessonStatus @default(SCHEDULED)
  movedFromDate DateTime?    @db.Date
  movedFromTime String?
  changeNote    String?
  changedAt     DateTime?

  attendance    Attendance[]

  @@index([groupId, date])
}

/** Посещаемость: одна отметка на студента и пару. Нет записи — отметку ещё не ставили. */
model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  semester  Int
  grades    Grade[]

  @@unique([studentId, courseId, semester])
}

model Grade {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  kind         GradeKind
  value        String
  points       Int?
  date         DateTime
  note         String?

  @@index([enrollmentId])
}

model Exam {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id])
  date     DateTime
  room     String
  kind     ExamKind
  teacher  String
}

model RequestType {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  description String
  category    String
  needsPaper  Boolean   @default(false)
  fields      Json
  slaDays     Int
  isCertificate Boolean @default(false)
  requests    Request[]
}

model Request {
  id          String         @id @default(cuid())
  number      Int            @default(autoincrement())
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  typeId      String
  type        RequestType    @relation(fields: [typeId], references: [id])
  status      RequestStatus  @default(NEW)
  payload     Json
  comment     String?
  wantsPaper  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assigneeId  String?
  assignee    Staff?         @relation(fields: [assigneeId], references: [id])
  events      RequestEvent[]
  certificate Certificate?

  @@index([studentId, createdAt])
  @@index([status])
}

model RequestEvent {
  id           String         @id @default(cuid())
  requestId    String
  request      Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus   RequestStatus?
  toStatus     RequestStatus
  authorUserId String
  author       User           @relation(fields: [authorUserId], references: [id])
  message      String?
  createdAt    DateTime       @default(now())

  @@index([requestId])
}

model Certificate {
  id         String   @id @default(cuid())
  requestId  String   @unique
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verifyCode String   @unique
  issuedAt   DateTime @default(now())
  validUntil DateTime
  revoked    Boolean  @default(false)
}

model Announcement {
  id            String   @id @default(cuid())
  title         String
  body          String
  audience      Audience
  facultyId     String?
  faculty       Faculty? @relation(fields: [facultyId], references: [id])
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id])
  pinned        Boolean  @default(false)
  authorStaffId String
  author        Staff    @relation(fields: [authorStaffId], references: [id])
  publishedAt   DateTime @default(now())
}

model Deadline {
  id        String   @id @default(cuid())
  title     String
  dueAt     DateTime
  audience  Audience
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  link      String?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model WellbeingCheckin {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  mood      Int
  createdAt DateTime @default(now())

  @@unique([studentId, weekStart])
}

model AiChat {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([studentId, updatedAt])
}

model AiMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  draft     Json?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([studentId, createdAt])
}

/* ---------- Материалы и домашние задания ---------- */

enum SubmissionStatus {
  SUBMITTED // на проверке
  RETURNED // на доработке
  ACCEPTED // принято
}

/** Учебный материал по дисциплине для группы: ссылка и/или файлы. */
model Material {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String?
  createdAt   DateTime     @default(now())
  files       Attachment[]

  @@index([groupId, courseId])
}

/** Домашнее задание группе по дисциплине. */
model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueAt       DateTime
  createdAt   DateTime     @default(now())
  files       Attachment[]
  submissions Submission[]

  @@index([groupId, courseId])
}

/** Сдача студента: одна на задание, повторная отправка заменяет файлы и снова ставит «на проверке». */
model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comment        String?
  status         SubmissionStatus @default(SUBMITTED)
  /// растёт при каждой отправке; проверка преподавателя привязана к версии, которую он видел
  version        Int              @default(1)
  teacherComment String?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  files          Attachment[]

  @@unique([assignmentId, studentId])
}

/** Файл (на диске в DATA_DIR/uploads под случайным именем). Принадлежит материалу, заданию или сдаче. */
model Attachment {
  id           String      @id @default(cuid())
  name         String
  mime         String
  size         Int
  storageKey   String      @unique
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?   @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  messageId    String?
  message      Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

/* ---------- Сообщения ---------- */

enum ConversationKind {
  DIRECT // студент ↔ преподаватель его дисциплины
  DEANERY // переписка с деканатом как отделом (студент или преподаватель ↔ любой сотрудник деканата)
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

/** Диалог. Повод (заявка / дисциплина / задание) — необязательная ссылка для контекста. */
model Conversation {
  id           String                    @id @default(cuid())
  kind         ConversationKind
  status       ConversationStatus        @default(OPEN)
  subject      String
  /// для обращений в деканат: факультет студента (маршрутизация); null — общий деканат
  facultyId    String?
  startedById  String
  startedBy    User                      @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: Cascade)
  contextType  String?
  contextId    String?
  contextLabel String?
  createdAt    DateTime                  @default(now())
  lastMessageAt DateTime                 @default(now())
  resolvedAt   DateTime?
  participants ConversationParticipant[]
  messages     Message[]

  @@index([kind, facultyId, status])
  @@index([lastMessageAt])
}

/** Участник диалога и момент последнего прочтения. Сотрудники деканата добавляются при первом ответе/прочтении. */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  files          Attachment[]
  /// ключ отправки из браузера: повтор того же запроса (двойное нажатие, повтор после сбоя сети) не создаёт дубль
  clientKey      String?

  @@index([conversationId, createdAt])
  @@unique([authorId, clientKey])
}

/* ---------- Фото студента ---------- */

enum PhotoStatus {
  PENDING // на проверке в деканате
  APPROVED // принято — идёт на студенческий билет и пропуск
  REJECTED // не подходит, причина в comment
}

/** Фото 3×4 для документов. Хранится на диске (DATA_DIR/photos), уже обрезанное и пережатое в JPEG без метаданных. */
model StudentPhoto {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storageKey   String      @unique
  size         Int
  status       PhotoStatus @default(PENDING)
  comment      String?
  createdAt    DateTime    @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([studentId, status])
  @@index([status])
}

enum AccountAction {
  CREATED
  BLOCKED
  UNBLOCKED
  PASSWORD_RESET
  PASSWORD_CHANGED
  TRANSFERRED
}

/// Журнал действий с аккаунтом студента (кто из деканата и что сделал). Пароли сюда не пишем.
model AccountEvent {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User          @relation("AccountActor", fields: [actorUserId], references: [id])
  action      AccountAction
  details     String?
  createdAt   DateTime      @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
}
