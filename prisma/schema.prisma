generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF // деканат
  TEACHER
}

enum Assessment {
  EXAM
  CREDIT
  GRADED_CREDIT
  COURSEWORK
}

enum LessonKind {
  LECTURE
  PRACTICE
  LAB
  EXAM
  CONSULTATION
}

enum LessonStatus {
  SCHEDULED
  MOVED
  CANCELLED
}

enum GradeKind {
  CURRENT
  MIDTERM
  FINAL
  RETAKE
}

enum ExamKind {
  EXAM
  CREDIT
  RETAKE
}

enum RequestStatus {
  NEW
  IN_REVIEW
  NEED_INFO
  READY
  DONE
  REJECTED
}

enum Audience {
  ALL
  FACULTY
  GROUP
}

enum NotificationKind {
  SCHEDULE_CHANGE
  REQUEST_STATUS
  ANNOUNCEMENT
  DEADLINE
  GRADE
  SYSTEM
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                   String                    @id @default(cuid())
  login                String                    @unique
  passwordHash         String
  role                 Role
  createdAt            DateTime                  @default(now())
  /// заблокирован деканатом: войти нельзя, сессии удалены
  blockedAt            DateTime?
  blockReason          String?
  /// выдан временный пароль — при входе обязательно задать свой
  mustChangePassword   Boolean                   @default(false)
  lastLoginAt          DateTime?
  accountActions       AccountEvent[]            @relation("AccountActor")
  sessions             Session[]
  student              Student?
  staff                Staff?
  teacher              Teacher?
  notifications        Notification[]
  events               RequestEvent[]
  pushSubs             PushSubscription[]
  uploads              Attachment[]
  conversations        ConversationParticipant[]
  messages             Message[]
  conversationsStarted Conversation[]            @relation("ConversationStarter")
  aiChats              AiChat[]
  reminders            Reminder[]
  knowledgeDocs        KnowledgeDoc[]
  nudges               NudgeLog[]
}

/**
 * Подписка устройства на push-уведомления (Web Push). Одно устройство/браузер — одна запись.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Faculty {
  id            String         @id @default(cuid())
  name          String
  shortName     String
  programs      Program[]
  students      Student[]
  staff         Staff[]
  announcements Announcement[]
  deadlines     Deadline[]
  knowledgeDocs KnowledgeDoc[]
}

model Program {
  id        String    @id @default(cuid())
  facultyId String
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  name      String
  code      String
  groups    Group[]
  students  Student[]
}

model Group {
  id            String         @id @default(cuid())
  programId     String
  program       Program        @relation(fields: [programId], references: [id])
  name          String         @unique
  course        Int
  students      Student[]
  lessons       Lesson[]
  exams         Exam[]
  announcements Announcement[]
  deadlines     Deadline[]
  materials     Material[]
  assignments   Assignment[]
}

model Student {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastName      String
  firstName     String
  middleName    String?
  facultyId     String
  faculty       Faculty            @relation(fields: [facultyId], references: [id])
  programId     String
  program       Program            @relation(fields: [programId], references: [id])
  course        Int
  groupId       String
  group         Group              @relation(fields: [groupId], references: [id])
  subgroup      Int
  recordBookNo  String
  email         String?
  scholarship   Boolean            @default(false)
  enrollments   Enrollment[]
  requests      Request[]
  checkins      WellbeingCheckin[]
  aiChats       AiChat[]
  aiMessages    AiMessage[]
  attendance    Attendance[]
  submissions   Submission[]
  photos        StudentPhoto[]
  accountEvents AccountEvent[]
  documents     StudentDocument[]
  cases         SituationCase[]
  appointments  Appointment[]
  /// код электронного студенческого билета (QR → публичная проверка «действующий студент»)
  idCode        String?            @unique
}

model Staff {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  position      String
  facultyId     String?
  faculty       Faculty?       @relation(fields: [facultyId], references: [id])
  announcements Announcement[]
  requests      Request[]
}

model Teacher {
  id          String            @id @default(cuid())
  userId      String?           @unique
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName    String
  department  String
  lessons     Lesson[]
  materials   Material[]
  assignments Assignment[]
  approvals   RequestApproval[]
}

model Course {
  id            String         @id @default(cuid())
  name          String
  department    String
  assessment    Assessment
  lessons       Lesson[]
  enrollments   Enrollment[]
  exams         Exam[]
  deadlines     Deadline[]
  materials     Material[]
  assignments   Assignment[]
  knowledgeDocs KnowledgeDoc[]
}

model Lesson {
  id            String       @id @default(cuid())
  groupId       String
  group         Group        @relation(fields: [groupId], references: [id])
  subgroup      Int?
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  teacherId     String
  teacher       Teacher      @relation(fields: [teacherId], references: [id])
  date          DateTime     @db.Date
  startTime     String
  endTime       String
  room          String
  building      String
  kind          LessonKind
  status        LessonStatus @default(SCHEDULED)
  movedFromDate DateTime?    @db.Date
  movedFromTime String?
  changeNote    String?
  changedAt     DateTime?

  attendance Attendance[]

  @@index([groupId, date])
}

/**
 * Посещаемость: одна отметка на студента и пару. Нет записи — отметку ещё не ставили.
 */
model Attendance {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean
  markedAt  DateTime @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  semester  Int
  grades    Grade[]

  @@unique([studentId, courseId, semester])
}

model Grade {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  kind         GradeKind
  value        String
  points       Int?
  date         DateTime
  note         String?

  @@index([enrollmentId])
}

model Exam {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id])
  date     DateTime
  room     String
  kind     ExamKind
  teacher  String
}

model RequestType {
  id            String    @id @default(cuid())
  code          String    @unique
  title         String
  description   String
  category      String
  needsPaper    Boolean   @default(false)
  fields        Json
  slaDays       Int
  isCertificate Boolean   @default(false)
  requests      Request[]
  /// выдаётся сразу, без сотрудника (данные уже есть в системе); деканат может отозвать
  autoIssue     Boolean   @default(false)
  /// услуга доступна студентам (управляет деканат)
  enabled       Boolean   @default(true)
  /// документы к услуге: [{kind, required}] — берутся из «Моих документов»
  docs          Json      @default("[]")
  /// маршрут согласования до деканата: [{kind: "TEACHER"}] — преподаватель дисциплины из заявки
  route         Json      @default("[]")
}

model Request {
  id            String            @id @default(cuid())
  number        Int               @default(autoincrement())
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  typeId        String
  type          RequestType       @relation(fields: [typeId], references: [id])
  status        RequestStatus     @default(NEW)
  payload       Json
  comment       String?
  wantsPaper    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  assigneeId    String?
  assignee      Staff?            @relation(fields: [assigneeId], references: [id])
  events        RequestEvent[]
  certificate   Certificate?
  /// срок готовности по регламенту услуги (рабочие дни)
  dueAt         DateTime?
  /// просрочка передана руководителю
  escalatedAt   DateTime?
  /// выдано автоматически (без сотрудника)
  autoIssued    Boolean           @default(false)
  /// оценка студента после завершения: 1–5
  rating        Int?
  ratingComment String?
  ratedAt       DateTime?
  /// в рамках жизненной ситуации
  caseId        String?
  case          SituationCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  approvals     RequestApproval[]
  documents     RequestDocument[]
  appointments  Appointment[]

  @@index([studentId, createdAt])
  @@index([status])
  @@index([caseId])
}

model RequestEvent {
  id           String         @id @default(cuid())
  requestId    String
  request      Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus   RequestStatus?
  toStatus     RequestStatus
  authorUserId String
  author       User           @relation(fields: [authorUserId], references: [id])
  message      String?
  createdAt    DateTime       @default(now())

  @@index([requestId])
}

model Certificate {
  id           String    @id @default(cuid())
  requestId    String    @unique
  request      Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verifyCode   String    @unique
  issuedAt     DateTime  @default(now())
  validUntil   DateTime
  revoked      Boolean   @default(false)
  revokedAt    DateTime?
  revokeReason String?
}

model Announcement {
  id            String   @id @default(cuid())
  title         String
  body          String
  audience      Audience
  facultyId     String?
  faculty       Faculty? @relation(fields: [facultyId], references: [id])
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id])
  pinned        Boolean  @default(false)
  authorStaffId String
  author        Staff    @relation(fields: [authorStaffId], references: [id])
  publishedAt   DateTime @default(now())
}

model Deadline {
  id        String   @id @default(cuid())
  title     String
  dueAt     DateTime
  audience  Audience
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id])
  link      String?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model WellbeingCheckin {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  mood      Int
  createdAt DateTime @default(now())

  @@unique([studentId, weekStart])
}

/// Чат с помощником — у любой роли (студент, преподаватель, деканат); владелец — userId.
model AiChat {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  /// когда пользователь последний раз открывал чат — для отметки «помощник написал первым»
  seenAt    DateTime?

  @@index([studentId, updatedAt])
  @@index([userId, updatedAt])
}

model AiMessage {
  id          String   @id @default(cuid())
  chatId      String
  chat        AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role        ChatRole
  content     String
  draft       Json?
  /// ссылки-подсказки под ответом («Открыть заявки»)
  links       Json?
  /// мини-раздел в ответе (расписание, оценки, входящие…): тип и параметры, данные подгружаются при показе
  widget      Json?
  /// кнопки-уточнения и следующие шаги под ответом
  suggestions Json?
  /// помощник написал сам (утренние подсказки), а не в ответ на вопрос
  proactive   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([chatId, createdAt])
  @@index([studentId, createdAt])
}

/**
 * ---------- Материалы и домашние задания ----------
 */

enum SubmissionStatus {
  SUBMITTED // на проверке
  RETURNED // на доработке
  ACCEPTED // принято
}

/**
 * Учебный материал по дисциплине для группы: ссылка и/или файлы.
 */
model Material {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String?
  createdAt   DateTime     @default(now())
  files       Attachment[]

  @@index([groupId, courseId])
}

/**
 * Домашнее задание группе по дисциплине.
 */
model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueAt       DateTime
  createdAt   DateTime     @default(now())
  files       Attachment[]
  submissions Submission[]

  @@index([groupId, courseId])
}

/**
 * Сдача студента: одна на задание, повторная отправка заменяет файлы и снова ставит «на проверке».
 */
model Submission {
  id             String           @id @default(cuid())
  assignmentId   String
  assignment     Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comment        String?
  status         SubmissionStatus @default(SUBMITTED)
  /// растёт при каждой отправке; проверка преподавателя привязана к версии, которую он видел
  version        Int              @default(1)
  teacherComment String?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  files          Attachment[]

  @@unique([assignmentId, studentId])
}

/**
 * Файл (на диске в DATA_DIR/uploads под случайным именем). Принадлежит материалу, заданию или сдаче.
 */
model Attachment {
  id           String        @id @default(cuid())
  name         String
  mime         String
  size         Int
  storageKey   String        @unique
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  materialId   String?
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  messageId    String?
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeDoc KnowledgeDoc?
  createdAt    DateTime      @default(now())
}

/**
 * ---------- Сообщения ----------
 */

enum ConversationKind {
  DIRECT // студент ↔ преподаватель его дисциплины
  DEANERY // переписка с деканатом как отделом (студент или преподаватель ↔ любой сотрудник деканата)
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

/**
 * Диалог. Повод (заявка / дисциплина / задание) — необязательная ссылка для контекста.
 */
model Conversation {
  id            String                    @id @default(cuid())
  kind          ConversationKind
  status        ConversationStatus        @default(OPEN)
  subject       String
  /// для обращений в деканат: факультет студента (маршрутизация); null — общий деканат
  facultyId     String?
  startedById   String
  startedBy     User                      @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: Cascade)
  contextType   String?
  contextId     String?
  contextLabel  String?
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now())
  resolvedAt    DateTime?
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([kind, facultyId, status])
  @@index([lastMessageAt])
}

/**
 * Участник диалога и момент последнего прочтения. Сотрудники деканата добавляются при первом ответе/прочтении.
 */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  files          Attachment[]
  /// ключ отправки из браузера: повтор того же запроса (двойное нажатие, повтор после сбоя сети) не создаёт дубль
  clientKey      String?

  @@unique([authorId, clientKey])
  @@index([conversationId, createdAt])
}

/**
 * ---------- Фото студента ----------
 */

enum PhotoStatus {
  PENDING // на проверке в деканате
  APPROVED // принято — идёт на студенческий билет и пропуск
  REJECTED // не подходит, причина в comment
}

/**
 * Фото 3×4 для документов. Хранится на диске (DATA_DIR/photos), уже обрезанное и пережатое в JPEG без метаданных.
 */
model StudentPhoto {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storageKey   String      @unique
  size         Int
  status       PhotoStatus @default(PENDING)
  comment      String?
  createdAt    DateTime    @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([studentId, status])
  @@index([status])
}

enum AccountAction {
  CREATED
  BLOCKED
  UNBLOCKED
  PASSWORD_RESET
  PASSWORD_CHANGED
  TRANSFERRED
}

/// Журнал действий с аккаунтом студента (кто из деканата и что сделал). Пароли сюда не пишем.
model AccountEvent {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User          @relation("AccountActor", fields: [actorUserId], references: [id])
  action      AccountAction
  details     String?
  createdAt   DateTime      @default(now())

  @@index([studentId, createdAt])
  @@index([createdAt])
}

/// Напоминание, поставленное через помощника («напомни завтра в 9 про лабу»): в срок — уведомление и push.
model Reminder {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String?
  dueAt     DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, sentAt, dueAt])
  @@index([sentAt, dueAt])
}

/**
 * ---------- Библиотека знаний помощника ----------
 */

enum KnowledgeScope {
  UNIVERSITY // весь вуз (деканат)
  FACULTY // один факультет (деканат)
  COURSE // дисциплина преподавателя: его группы или одна группа
}

/// Материал библиотеки: положение, инструкция, требования. По нему помощник отвечает студентам (поиск по фрагментам).
model KnowledgeDoc {
  id           String           @id @default(cuid())
  title        String
  /// текст: написан на сайте или извлечён из PDF/Word (автор может поправить)
  body         String
  scope        KnowledgeScope
  facultyId    String?
  faculty      Faculty?         @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// COURSE: одна группа; пусто — все группы автора по этой дисциплине
  groupId      String?
  authorId     String
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// исходный файл, если материал загружен из PDF/Word
  attachmentId String?          @unique
  attachment   Attachment?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  chunks       KnowledgeChunk[]

  @@index([scope, facultyId])
  @@index([courseId])
}

/// Фрагмент материала (абзац-раздел до ~900 знаков) — единица поиска и цитирования.
model KnowledgeChunk {
  id      String       @id @default(cuid())
  docId   String
  doc     KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  idx     Int
  heading String?
  text    String

  @@index([docId])
}

/// Что помощник уже сообщал пользователю сам (ключ события) — чтобы не повторяться. Ключ day:<дата> — утренняя сводка.
model NudgeLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

/**
 * ---------- Единое окно: согласования, документы, жизненные ситуации, приём ----------
 */

enum ApprovalStatus {
  WAITING // очередь ещё не дошла
  PENDING // ждёт решения
  APPROVED
  REJECTED
}

/// Шаг согласования заявки до деканата (сейчас — преподаватель дисциплины). Идут по порядку; отказ отклоняет заявку.
model RequestApproval {
  id              String         @id @default(cuid())
  requestId       String
  request         Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  idx             Int
  teacherId       String?
  teacher         Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  status          ApprovalStatus @default(WAITING)
  comment         String?
  decidedByUserId String?
  decidedAt       DateTime?

  @@unique([requestId, idx])
  @@index([teacherId, status])
}

enum DocKind {
  PASSPORT
  SNILS
  INN
  MED_086 // медсправка 086/у
  FLUORO // флюорография
  MEDICAL // справка о болезни
  BANK // реквизиты карты для стипендии
  MILITARY // приписное / повестка
  OTHER
}

enum DocStatus {
  PENDING // загружен, не проверен
  VERIFIED // проверен сотрудником
  REJECTED // не принят (причина — reviewNote)
}

/// «Мои документы»: загружается один раз и подставляется в заявки. Файл — DATA_DIR/documents, выдача только через /api/documents/[id].
model StudentDocument {
  id               String            @id @default(cuid())
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind             DocKind
  fileName         String
  mime             String
  size             Int
  storageKey       String            @unique
  validUntil       DateTime?
  status           DocStatus         @default(PENDING)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  requests         RequestDocument[]

  @@index([studentId, kind])
}

model RequestDocument {
  requestId  String
  request    Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId String
  document   StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([requestId, documentId])
}

enum CaseStatus {
  OPEN
  DONE
  CANCELLED
}

/// Жизненная ситуация студента («Я заболел», «Ухожу в армию»): чек-лист шагов из src/config/situations.ts.
model SituationCase {
  id        String     @id @default(cuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String
  status    CaseStatus @default(OPEN)
  createdAt DateTime   @default(now())
  closedAt  DateTime?
  steps     CaseStep[]
  requests  Request[]

  @@index([studentId, status])
}

/// Шаг ситуации, отмеченный вручную (прочитал, сообщил преподавателям); остальные шаги вычисляются по данным.
model CaseStep {
  caseId String
  case   SituationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key    String
  doneAt DateTime      @default(now())
  note   String?

  @@id([caseId, key])
}

enum AppointmentStatus {
  BOOKED
  DONE
  NO_SHOW
  CANCELLED
}

/// Запись на приём в деканат (забрать оригинал, подписать). Слоты — по часам деканата из src/config/services.ts.
model Appointment {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  purpose   String
  requestId String?
  request   Request?          @relation(fields: [requestId], references: [id], onDelete: SetNull)
  status    AppointmentStatus @default(BOOKED)
  /// занятость слота: время у активной записи, пусто у отменённой — один слот нельзя занять дважды
  slotKey   String?           @unique
  createdAt DateTime          @default(now())

  @@index([startsAt])
  @@index([studentId, startsAt])
}
