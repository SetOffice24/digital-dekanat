# Скопируйте в .env и заполните. .env никогда не коммитится.
DATABASE_URL="postgresql://univer:univer_dev@localhost:5433/univer"
APP_URL="http://localhost:3000"

# ИИ-помощник: rules (без внешнего ИИ) | gigachat | gateway (OpenAI-совместимый шлюз). Подробно — docs/GIGACHAT.md
AI_PROVIDER="rules"
AI_MODEL=""
# GigaChat: Authorization Key из личного кабинета (секрет — только в .env) и scope
GIGACHAT_AUTH_KEY=""
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
# Шлюз (gateway)
AI_BASE_URL=""
AI_API_KEY=""

# Каталог для PDF справок (в Docker — volume)
DATA_DIR="./data"

# Push-уведомления на телефон (Web Push). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dekanat@univer.example
