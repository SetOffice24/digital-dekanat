# Скопируйте в .env и заполните. .env никогда не коммитится.
DATABASE_URL="postgresql://univer:univer_dev@localhost:5433/univer"
APP_URL="http://localhost:3000"

# ИИ-помощник: gateway (OpenAI-совместимый шлюз команды) или rules (без внешнего ИИ)
AI_PROVIDER="rules"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Каталог для PDF справок (в Docker — volume)
DATA_DIR="./data"

# Push-уведомления на телефон (Web Push). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dekanat@univer.example
