# Копия -> deploy/.env на сервере (chmod 600). Никогда не коммитить.
APP_URL=https://service.setoffice.ru
# порт, на котором приложение слушает 127.0.0.1 — на него проксирует nginx (deploy/nginx/service.setoffice.ru.conf)
APP_PORT=3210
DB_PASSWORD=
# ИИ-помощник: rules | gigachat | gateway. Подробно — docs/GIGACHAT.md
AI_PROVIDER=rules
AI_MODEL=
# GigaChat: Authorization Key (секрет), scope; в Docker нужен сертификат Минцифры в deploy/certs/ (docs/GIGACHAT.md)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_FILE=/app/certs/russian_trusted_root_ca.pem
# Шлюз (gateway)
AI_BASE_URL=
AI_API_KEY=
# Быстрый вход без пароля на странице входа — ВЫКЛЮЧЕН (сервис выглядит как настоящий; жюри входит по логинам из docs/jury-access.md).
# Включается только явной строкой DEMO_LOGIN=1.

# Push-уведомления на телефон (Web Push). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dekanat@univer.example
